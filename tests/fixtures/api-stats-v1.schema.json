{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HeliosDatabase/HeliosDB-Proxy/tests/fixtures/api-stats-v1.schema.json",
  "title": "HeliosProxy GET /api/stats, schema_version 1",
  "description": "The admin API's stats document for external pollers (docs/admin-api.md, \"GET /api/stats - schema_version 1\"). Every section is always present: {\"enabled\": false, \"reason\": ...} when its feature is compiled out or switched off. Within version 1 fields and enum values are only ever added, so a consumer must ignore the ones it does not know; a breaking change bumps schema_version. The proxy's own contract test validates strictly (a field not listed here fails it), so every field the proxy sends is listed.",
  "type": "object",
  "required": [
    "schema_version",
    "proxy_version",
    "generated_at",
    "uptime_secs",
    "nodes",
    "pools",
    "sessions",
    "traffic",
    "cache",
    "tenants",
    "rate_limit",
    "transaction_replay",
    "gateways"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proxy_version": {
      "type": "string"
    },
    "generated_at": {
      "$ref": "#/$defs/time"
    },
    "uptime_secs": {
      "$ref": "#/$defs/count"
    },
    "nodes": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/nodes"
        }
      ]
    },
    "pools": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/pools"
        }
      ]
    },
    "sessions": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/sessions"
        }
      ]
    },
    "traffic": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/traffic"
        }
      ]
    },
    "cache": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/cache"
        }
      ]
    },
    "tenants": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/tenants"
        }
      ]
    },
    "rate_limit": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/rate_limit"
        }
      ]
    },
    "transaction_replay": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/transaction_replay"
        }
      ]
    },
    "gateways": {
      "anyOf": [
        {
          "$ref": "#/$defs/disabled"
        },
        {
          "$ref": "#/$defs/gateways"
        }
      ]
    }
  },
  "$defs": {
    "count": {
      "description": "A non-negative integer: a counter when the name ends in _total (since startup), otherwise a value now.",
      "type": "integer",
      "minimum": 0
    },
    "count_or_null": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "string_or_null": {
      "type": [
        "string",
        "null"
      ]
    },
    "time": {
      "description": "RFC 3339, UTC, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "time_or_null": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/time"
        }
      ]
    },
    "disabled": {
      "description": "A section (or sub-section) whose feature is compiled out or switched off. It carries no other field.",
      "type": "object",
      "required": [
        "enabled",
        "reason"
      ],
      "properties": {
        "enabled": {
          "const": false
        },
        "reason": {
          "description": "Why: the cargo feature is not compiled in, or the configuration key that turns it on.",
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "object",
      "required": [
        "enabled",
        "write_leader",
        "load_balancer",
        "failovers_total",
        "reconnect_attempts_total",
        "backend_capacity_waits_total",
        "backend_capacity_refusals_total",
        "reconnects",
        "count",
        "healthy_count",
        "truncated",
        "items"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "write_leader": {
          "$ref": "#/$defs/string_or_null"
        },
        "load_balancer": {
          "enum": [
            "round_robin",
            "weighted_round_robin",
            "least_connections",
            "latency_based",
            "random",
            "power_of_two"
          ]
        },
        "failovers_total": {
          "$ref": "#/$defs/count"
        },
        "reconnect_attempts_total": {
          "$ref": "#/$defs/count"
        },
        "backend_capacity_waits_total": {
          "$ref": "#/$defs/count"
        },
        "backend_capacity_refusals_total": {
          "$ref": "#/$defs/count"
        },
        "reconnects": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reconnects"
            }
          ]
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "healthy_count": {
          "$ref": "#/$defs/count"
        },
        "truncated": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
